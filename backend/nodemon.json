{
  "watch": [
    "server.js",
    "routes/",
    "controllers/",
    "models/",
    "middleware/",
    "config/",
    "utils/",
    "scripts/"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules/*",
    "uploads/*",
    "public/*",
    "email_previews/*",
    "scratch/*",
    "*.test.js",
    "*.log"
  ],
  "delay": "1000"
}
